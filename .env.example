# Configuración de ejemplo. Copiar a .env para personalizar: cp .env.example .env
# El archivo .env es opcional: compose.yaml define estos mismos valores por defecto
# con la sintaxis ${VAR:-valor}, así que un clon limpio arranca sin él.
# .env NO se versiona (está en .gitignore).
#
# ⚠️ POSTGRES_* solo se aplican al inicializar un volumen vacío. Para cambiar la
#    contraseña de una BD ya creada hay que recrear el volumen (docker compose down -v)
#    o cambiarla dentro de PostgreSQL (ALTER USER).

# Credenciales de PostgreSQL (las usa db y, desde las mismas variables, el DATABASE_URL del backend)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=rescue123
POSTGRES_DB=appdb

# Puerto del host donde se publica el frontend (Nginx escucha en el 80 del contenedor)
FRONTEND_PORT=8080
